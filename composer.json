{
    "name": "componist/reminder-notifications",
    "description": "Livewire-powered reminder notifications for Laravel.",
    "keywords": [
        "laravel",
        "livewire",
        "notifications",
        "reminder",
        "scheduler"
    ],
    "homepage": "https://componist.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Componist Developer",
            "email": "info@componist.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "componist/core": "^1.0.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.9"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon.dist"
    },
    "autoload": {
        "psr-4": {
            "Componist\\ReminderNotifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Componist\\ReminderNotifications\\ReminderNotificationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
